# Compose
COMPOSE_PROJECT_NAME=aims
BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Django
PROD=True
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=portal.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://portal.example.com
CORS_ALLOWED_ORIGINS=https://portal.example.com

# Created once after migrations. Existing users and passwords are never modified.
# Replace this known initial password before exposing the service publicly.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=FAde3464j
DJANGO_SUPERUSER_EMAIL=

# PostgreSQL. These values initialize the bundled database and are read by Django.
POSTGRES_DB=aims
POSTGRES_USER=aims
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# PgBouncer transaction pool. Keep the database connection cap below PostgreSQL's
# max_connections so migrations, backups, and administration retain headroom.
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=40
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=10
PGBOUNCER_MAX_DB_CONNECTIONS=60
PGBOUNCER_QUERY_WAIT_TIMEOUT=120

# Redis and application caches
CACHE_KEY_PREFIX=aims-production
CACHE_TIMEOUT=300
ROUTING_POLICY_CACHE_TTL=300
REDIS_SOCKET_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2
REDIS_RETRY_ON_TIMEOUT=True

# Gunicorn
WEB_CONCURRENCY=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=2000
GUNICORN_MAX_REQUESTS_JITTER=200

# Periodic stale-LIVE and rollup maintenance
MAINTENANCE_INTERVAL_SECONDS=60
MAINTENANCE_LOOKBACK_MINUTES=60

# Public recording URL, if recordings are served separately.
CALL_RECORDINGS_BASE_URL=https://recordings.example.com
CALL_RECORDINGS_FILE_EXTENSION=wav

# TLS is expected at the host ingress proxy. Start HSTS at zero until HTTPS is verified.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Optional email settings used by the application.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
